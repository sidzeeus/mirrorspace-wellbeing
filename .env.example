# Environment variables for the whole stack.
#
# `docker compose up` works with this file as it is. To change something locally, copy
# it to `.env` and edit the copy; `.env` is ignored by git and overrides this file.
#
# Every value here is a LOCAL DEVELOPMENT default. None of them is a real secret, and
# none may be used in production. Production values live in the host's secret store.

# --- General -----------------------------------------------------------------------

# Which settings module Django loads: config.settings.local | test | production
DJANGO_SETTINGS_MODULE=config.settings.local

# Name shown in emails and the API description. Working name only.
APP_NAME=Mirrorspace

# Label attached to logs and error reports: local | staging | production
ENVIRONMENT=local

# Minimum log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Django security ---------------------------------------------------------------

# Signs sessions, CSRF tokens and emailed links. REQUIRED in production: a long random
# value from the secret store, for example:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=local-development-only-key-do-not-use-anywhere-else

# Hostnames the API answers to, comma separated. REQUIRED in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Path of the Django admin. Change it in production so it is not at a guessable URL.
DJANGO_ADMIN_URL=admin/

# --- Frontend, CORS and cookies ----------------------------------------------------

# Where the Next.js app is served. Used for links in emails. REQUIRED in production.
FRONTEND_URL=http://localhost:3000

# Origins allowed to call the API with cookies, comma separated. Never use "*".
# REQUIRED in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Origins trusted for CSRF-protected requests, comma separated. REQUIRED in production.
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Send cookies over HTTPS only. Must be true anywhere except local development
# (production settings force it on regardless).
COOKIE_SECURE=false

# Set to the shared parent domain (for example .example.com) when the frontend and API
# are on sibling subdomains. Leave empty when they share one host.
COOKIE_DOMAIN=

# Idle sign-in timeout in seconds. Default: 7 days.
SESSION_COOKIE_AGE_SECONDS=604800

# --- Database and Redis ------------------------------------------------------------

# PostgreSQL connection. The host `db` is the docker compose service; use `localhost`
# when running Django directly on your machine. REQUIRED in production.
DATABASE_URL=postgres://wellbeing:wellbeing@db:5432/wellbeing

# Seconds a database connection is reused before reconnecting.
DATABASE_CONN_MAX_AGE=60

# Redis for the Celery queue, cache and rate limits. REQUIRED in production.
REDIS_URL=redis://redis:6379/0

# --- Email -------------------------------------------------------------------------

# Local: emails are printed to the worker's log. Production: the SMTP backend
# (django.core.mail.backends.smtp.EmailBackend) with the provider's credentials.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# The From address. Must be on a verified sending domain. REQUIRED in production.
DEFAULT_FROM_EMAIL=no-reply@localhost

# --- Account rules -----------------------------------------------------------------

# How long a password-reset link works, in seconds. Default: 1 hour.
PASSWORD_RESET_TIMEOUT_SECONDS=3600

# How long an email-confirmation link works, in seconds. Default: 3 days.
EMAIL_VERIFICATION_MAX_AGE_SECONDS=259200

# Accounts that never confirm their email are deleted after this many days.
UNVERIFIED_ACCOUNT_TTL_DAYS=7

# --- Privacy -----------------------------------------------------------------------

# Keys that encrypt the free text students write (trigger names, "what helped", and
# later the safety plan and contact details). Comma separated: the first key encrypts,
# all keys can decrypt, so a new key can be added in front to rotate.
# REQUIRED in production. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing a key makes the data encrypted with it unreadable: back it up like the database.
# Left unset locally, a built-in development key is used.
# FIELD_ENCRYPTION_KEYS=

# Secret used for one-way fingerprints: a contact's email in the do-not-email list,
# and a deleted user's id in the audit trail. REQUIRED in production: a long random
# value. It must NEVER change once in use, or the do-not-email list stops matching.
# Left unset locally, a built-in development value is used.
# PSEUDONYM_KEY=

# Consent and security events are purged after this many days. Default: 12 months.
AUDIT_RETENTION_DAYS=365

# --- Safety and sharing ------------------------------------------------------------

# Public base URL of this API. Used for the one-click unsubscribe header in emails to
# trusted contacts. REQUIRED in production.
API_BASE_URL=http://localhost:8000

# A helpline entry is flagged stale this many days after a person last verified it.
RESOURCE_MAX_AGE_DAYS=90

# The weekly note pauses itself unless the student confirms it at least this often.
CONSENT_RECONFIRM_DAYS=90

# Most Support (SOS) messages one student can send in 24 hours.
SOS_DAILY_LIMIT=6

# How long an invitation link to a trusted contact works, in seconds. Default: 14 days.
CONTACT_INVITATION_MAX_AGE_SECONDS=1209600

# Shared secret for the email provider's bounce/complaint webhook
# (POST /api/v1/webhooks/email-events, header X-Webhook-Secret). Empty disables it.
EMAIL_WEBHOOK_SECRET=

# Show exercise and resource content that has NOT been signed off by a qualified
# reviewer, labelled as unreviewed. Development only; production ignores this.
SHOW_UNREVIEWED_CONTENT=true

# --- Production-only ---------------------------------------------------------------

# Number of trusted reverse proxies in front of the API. Needed to rate-limit by the
# real client address. 0 locally; usually 1 in production.
NUM_PROXIES=0

# Redirect HTTP to HTTPS. Production default is true.
# SECURE_SSL_REDIRECT=true

# Strict-Transport-Security lifetime in seconds. Start low (3600), raise to 31536000
# once HTTPS is confirmed on every hostname.
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=false

# Error tracking. Leave empty to keep Sentry off. Events are scrubbed of request
# bodies, cookies, headers, user details and local variables before sending.
SENTRY_DSN=

# Version label attached to error reports, normally the Git commit SHA.
# RELEASE=

# --- Frontend ----------------------------------------------------------------------

# Where the frontend server reaches the API. The browser never calls the API directly:
# it calls /api/v1 on the frontend, which forwards the request here. Inside docker
# compose this is set to http://web:8000 for the frontend service.
API_INTERNAL_URL=http://localhost:8000

# Stops Next.js sending anonymous usage telemetry.
NEXT_TELEMETRY_DISABLED=1
